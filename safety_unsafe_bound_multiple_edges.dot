digraph G {
  fontname="Helvetica"
  fontsize=12
  rankdir=LR;
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=12];

  // Nodes
  n1 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n2 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n3 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n0 [label="", shape=circle, style=filled, fillcolor=white, color="blue", width=0.2, height=0.2, fixedsize=true];
  n4 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];

  // Hyperedges
  e1 [label="λ2", shape=box, style=rounded, color="black"];
  e0 [label="λ1", shape=box, style=rounded, color="black"];

  // Source connections
  n2 -> e1 [label=""];
  n0 -> e1 [style=dashed, color="blue", constraint=false, label="b0,0"];
  n1 -> e0 [label=""];
  n0 -> e0 [style=dashed, color="blue", constraint=false, label="b0,0"];

  // Target connections
  e1 -> n4 [label=""];
  e0 -> n3 [label=""];
}
