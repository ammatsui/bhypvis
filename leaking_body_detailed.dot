digraph BHypWithInterface {
  fontname="Helvetica"
  fontsize=12
  compound=true;
  rankdir=LR;
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=12];

  subgraph cluster_input {
    label="I_G";
    style=dashed;
    color="green";
    i0 [label="", shape=circle, style=filled, fillcolor="green", width=0.3, height=0.3, fixedsize=true];
  }

  subgraph cluster_main {
    label="G";
    style=solid;
    n1 [label="", shape=circle, style=filled, fillcolor=white, color="red", width=0.2, height=0.2, fixedsize=true];
    n0 [label="", shape=circle, style=filled, fillcolor=white, color="green", width=0.2, height=0.2, fixedsize=true];
    n2 [label="", shape=circle, style=filled, fillcolor=white, color="red", width=0.2, height=0.2, fixedsize=true];
    e0 [label="f", shape=box, style=rounded, color="black"];
    e1 [label="leak", shape=box, style=rounded, color="black"];
    n0 -> e0 [label=""];
    e0 -> n2 [label=""];
    n0 -> e1 [label=""];
    e1 -> n1 [label=""];
  }

  subgraph cluster_output {
    label="O_G";
    style=dashed;
    color="red";
    o0 [label="", shape=circle, style=filled, fillcolor="red", width=0.3, height=0.3, fixedsize=true];
    o1 [label="", shape=circle, style=filled, fillcolor="red", width=0.3, height=0.3, fixedsize=true];
  }

  // Interface morphisms
  i0 -> n0 [style=dotted, color="green", label="", lhead=cluster_main];
  n2 -> o1 [style=dotted, color="red", label="", ltail=cluster_main];
  n1 -> o0 [style=dotted, color="red", label="", ltail=cluster_main];
}
