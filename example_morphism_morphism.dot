digraph Morphism {
  fontname="Helvetica"
  fontsize=12
  rankdir=LR;
  compound=true;
  newrank=true;

  subgraph cluster_domain {
    label="Domain (A)";
    style=filled;
    fillcolor="lightblue";
    fontname="Helvetica";
    fontsize=12;

    dom_n0 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    dom_n1 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    dom_e0 [label="f", shape=box, style=rounded, color="black"];
    dom_n0 -> dom_e0 [label=""];
    dom_e0 -> dom_n1 [label=""];
    dom_anchor [shape=point, width=0, height=0, style=invis];
  }

  subgraph cluster_codomain {
    label="Codomain (B)";
    style=filled;
    fillcolor="lightcoral";
    fontname="Helvetica";
    fontsize=12;

    cod_n0 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    cod_n1 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    cod_n2 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    cod_e0 [label="f", shape=box, style=rounded, color="black"];
    cod_e1 [label="g", shape=box, style=rounded, color="black"];
    cod_n0 -> cod_e0 [label=""];
    cod_e0 -> cod_n1 [label=""];
    cod_n1 -> cod_e1 [label=""];
    cod_e1 -> cod_n2 [label=""];
    cod_anchor [shape=point, width=0, height=0, style=invis];
  }

  // Morphism mappings
  dom_n0 -> cod_n0 [style=dotted, color=forestgreen, constraint=false];
  dom_n1 -> cod_n1 [style=dotted, color=forestgreen, constraint=false];
  dom_e0 -> cod_e0 [style=dotted, color=purple, constraint=false];

  // Cluster-level morphism arrow
  dom_anchor -> cod_anchor [lhead=cluster_codomain, ltail=cluster_domain, style=bold, color=black, label="f", penwidth=2];
}
