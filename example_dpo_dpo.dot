digraph DPO {
  fontname="Helvetica"
  fontsize=12
  compound=true;
  newrank=true;
  label="Double Pushout Rewriting";
  labelloc=t;

  // Rule: L ← K → R
  subgraph rule_row {
    rank=same;
  subgraph cluster_L {
    label="L (LHS)";
    style=filled;
    fillcolor="lightblue";
    fontname="Helvetica";
    fontsize=12;

    l_n1 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    l_n0 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    l_e0 [label="f", shape=box, style=rounded, color="black"];
    l_n0 -> l_e0 [label=""];
    l_e0 -> l_n1 [label=""];
    l_anchor [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_K {
    label="K (interface)";
    style=filled;
    fillcolor="lightgreen";
    fontname="Helvetica";
    fontsize=12;

    k_n0 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    k_n1 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    k_e0 [label="g", shape=box, style=rounded, color="black"];
    k_n0 -> k_e0 [label=""];
    k_e0 -> k_n1 [label=""];
    k_anchor [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_R {
    label="R (RHS)";
    style=filled;
    fillcolor="lightcyan";
    fontname="Helvetica";
    fontsize=12;

    r_n0 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    r_n1 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    r_e0 [label="g", shape=box, style=rounded, color="black"];
    r_n0 -> r_e0 [label=""];
    r_e0 -> r_n1 [label=""];
    r_anchor [shape=point, width=0, height=0, style=invis];
  }
  }

  // Rewriting: G, D, H
  subgraph rewrite_row {
    rank=same;
  subgraph cluster_G {
    label="G (host)";
    style=filled;
    fillcolor="lightyellow";
    fontname="Helvetica";
    fontsize=12;

    g_n1 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    g_n2 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    g_n0 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    g_n3 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    g_e1 [label="g", shape=box, style=rounded, color="black"];
    g_e0 [label="h", shape=box, style=rounded, color="black"];
    g_n0 -> g_e1 [label=""];
    g_e1 -> g_n3 [label=""];
    g_n1 -> g_e0 [label=""];
    g_e0 -> g_n2 [label=""];
    g_anchor [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_D {
    label="D (context)";
    style=filled;
    fillcolor="lightcoral";
    fontname="Helvetica";
    fontsize=12;

    d_anchor [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_H {
    label="H (result)";
    style=filled;
    fillcolor="plum";
    fontname="Helvetica";
    fontsize=12;

    h_n1 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    h_n2 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    h_n0 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    h_n3 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    h_e1 [label="g", shape=box, style=rounded, color="black"];
    h_e0 [label="h", shape=box, style=rounded, color="black"];
    h_n0 -> h_e1 [label=""];
    h_e1 -> h_n3 [label=""];
    h_n1 -> h_e0 [label=""];
    h_e0 -> h_n2 [label=""];
    h_anchor [shape=point, width=0, height=0, style=invis];
  }
  }

  // Rule morphisms
  k_anchor -> l_anchor [ltail=cluster_K, lhead=cluster_L, label="l", style=bold, penwidth=2, dir=back];
  k_anchor -> r_anchor [ltail=cluster_K, lhead=cluster_R, label="r", style=bold, penwidth=2];
  // Vertical morphisms (pushout squares)
  l_anchor -> g_anchor [ltail=cluster_L, lhead=cluster_G, label="m", style=bold, penwidth=2, color=blue];
  k_anchor -> d_anchor [ltail=cluster_K, lhead=cluster_D, label="d", style=bold, penwidth=2, color=green];
  r_anchor -> h_anchor [ltail=cluster_R, lhead=cluster_H, label="n", style=bold, penwidth=2, color=purple];
  // Bottom row morphisms
  d_anchor -> g_anchor [ltail=cluster_D, lhead=cluster_G, label="", style=bold, penwidth=2, dir=back];
  d_anchor -> h_anchor [ltail=cluster_D, lhead=cluster_H, label="", style=bold, penwidth=2];

  // Pushout symbols
  po1 [label="PO", shape=none, fontsize=10, fontcolor=gray];
  po2 [label="PO", shape=none, fontsize=10, fontcolor=gray];
}
