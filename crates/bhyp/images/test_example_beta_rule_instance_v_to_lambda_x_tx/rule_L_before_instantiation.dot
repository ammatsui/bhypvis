digraph rule_L_before_instantiation {
  fontname="Helvetica"
  fontsize=12
  rankdir=LR;
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=12];

  // Nodes
  n4 [label="4", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n1 [label="1", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n2 [label="2", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n0 [label="0", shape=circle, style=filled, fillcolor=white, color="blue", width=0.2, height=0.2, fixedsize=true];
  n3 [label="3", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];

  // Hyperedges
  e2 [label="V:0", shape=ellipse, style=rounded, color="orange"];
  e0 [label="M:1", shape=ellipse, style=rounded, color="orange"];
  e3 [label="app", shape=box, style=rounded, color="black"];
  e1 [label="λ", shape=box, style=rounded, color="black"];

  // Source connections
  n0 -> e0 [label=""];
  n2 -> e3 [label="0"];
  n3 -> e3 [label="1"];
  n1 -> e1 [label=""];
  n0 -> e1 [style=dashed, color="blue", constraint=false, label="b0,0"];

  // Target connections
  e2 -> n3 [label=""];
  e0 -> n1 [label=""];
  e3 -> n4 [label=""];
  e1 -> n2 [label=""];
}
