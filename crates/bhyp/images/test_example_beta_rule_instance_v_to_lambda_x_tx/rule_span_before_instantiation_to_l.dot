digraph Morphism {
  fontname="Helvetica"
  fontsize=12
  rankdir=LR;
  compound=true;
  newrank=true;

  subgraph cluster_domain {
    label="K";
    style=filled;
    fillcolor="lightblue";
    fontname="Helvetica";
    fontsize=12;

    dom_n0 [label="0", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    dom_anchor [shape=point, width=0, height=0, style=invis];
  }

  subgraph cluster_codomain {
    label="L";
    style=filled;
    fillcolor="lightcoral";
    fontname="Helvetica";
    fontsize=12;

    cod_n4 [label="4", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    cod_n1 [label="1", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    cod_n2 [label="2", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    cod_n0 [label="0", shape=circle, style=filled, fillcolor=white, color="blue", width=0.2, height=0.2, fixedsize=true];
    cod_n3 [label="3", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
    cod_e2 [label="V:0", shape=ellipse, style=rounded, color="orange"];
    cod_e0 [label="M:1", shape=ellipse, style=rounded, color="orange"];
    cod_e3 [label="app", shape=box, style=rounded, color="black"];
    cod_e1 [label="λ", shape=box, style=rounded, color="black"];
    cod_e2 -> cod_n3 [label=""];
    cod_n0 -> cod_e0 [label=""];
    cod_e0 -> cod_n1 [label=""];
    cod_n2 -> cod_e3 [label="0"];
    cod_n3 -> cod_e3 [label="1"];
    cod_e3 -> cod_n4 [label=""];
    cod_n1 -> cod_e1 [label=""];
    cod_n0 -> cod_e1 [style=dashed, color="blue", constraint=false, label="b0,0"];
    cod_e1 -> cod_n2 [label=""];
    cod_anchor [shape=point, width=0, height=0, style=invis];
  }

  // Morphism mappings
  dom_n0 -> cod_n4 [style=dotted, color=forestgreen, constraint=false];

  // Cluster-level morphism arrow
  dom_anchor -> cod_anchor [lhead=cluster_codomain, ltail=cluster_domain, style=bold, color=black, label="to_l", penwidth=2];
}
