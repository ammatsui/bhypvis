digraph substitution_shared_for_left_right {
  fontname="Helvetica"
  fontsize=12
  rankdir=LR;
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=12];

  // Nodes
  n2 [label="2", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n0 [label="0", shape=circle, style=filled, fillcolor=white, color="blue", width=0.2, height=0.2, fixedsize=true];
  n1 [label="1", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];

  // Hyperedges
  e1 [label="λ", shape=box, style=rounded, color="black"];
  e0 [label="t", shape=box, style=rounded, color="black"];

  // Source connections
  n1 -> e1 [label=""];
  n0 -> e1 [style=dashed, color="blue", constraint=false, label="b0,0"];
  n0 -> e0 [label=""];

  // Target connections
  e1 -> n2 [label=""];
  e0 -> n1 [label=""];
}
