digraph substitution_shared_for_right_left {
  fontname="Helvetica"
  fontsize=12
  rankdir=LR;
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=12];

  // Nodes
  n0 [label="0", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n1 [label="1", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];

  // Hyperedges
  e0 [label="V:0", shape=ellipse, style=rounded, color="orange"];
  e1 [label="M:1", shape=ellipse, style=rounded, color="orange"];

  // Source connections
  n0 -> e1 [label=""];

  // Target connections
  e0 -> n0 [label=""];
  e1 -> n1 [label=""];
}
