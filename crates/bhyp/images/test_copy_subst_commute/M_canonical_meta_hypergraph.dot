digraph M_canonical_meta_hypergraph {
  fontname="Helvetica"
  fontsize=12
  rankdir=LR;
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=12];

  // Nodes
  n1 [label="1", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n0 [label="0", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n2 [label="2", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];

  // Hyperedges
  e0 [label="M:2", shape=ellipse, style=rounded, color="orange"];

  // Source connections
  n0 -> e0 [label="0"];
  n1 -> e0 [label="1"];

  // Target connections
  e0 -> n2 [label=""];
}
