digraph G {
  fontname="Helvetica"
  fontsize=12
  rankdir=LR;
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=12];

  // Nodes
  n5 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n0 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n6 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n3 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n2 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n1 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n4 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];

  // Hyperedges
  e3 [label="G1", shape=box, style=rounded, color="black"];
  e1 [label="M:2", shape=ellipse, style=rounded, color="orange"];
  e2 [label="G2", shape=box, style=rounded, color="black"];
  e0 [label="M:2", shape=ellipse, style=rounded, color="orange"];

  // Source connections
  n2 -> e3 [label=""];
  n0 -> e1 [label="0"];
  n1 -> e1 [label="1"];
  n2 -> e2 [label="0"];
  n4 -> e2 [label="1"];
  n0 -> e0 [label="0"];
  n1 -> e0 [label="1"];

  // Target connections
  e3 -> n5 [label=""];
  e1 -> n3 [label=""];
  e2 -> n6 [label=""];
  e0 -> n2 [label=""];
}
