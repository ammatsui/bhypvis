digraph G {
  fontname="Helvetica"
  fontsize=12
  rankdir=LR;
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=12];

  // Nodes
  n4 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n2 [label="", shape=circle, style=filled, fillcolor=white, color="blue", width=0.2, height=0.2, fixedsize=true];
  n7 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n6 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n1 [label="", shape=circle, style=filled, fillcolor=white, color="blue", width=0.2, height=0.2, fixedsize=true];
  n0 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n5 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];
  n3 [label="", shape=circle, style=filled, fillcolor=white, color="black", width=0.2, height=0.2, fixedsize=true];

  // Hyperedges
  e1 [label="g", shape=box, style=rounded, color="black"];
  e4 [label="λ", shape=box, style=rounded, color="black"];
  e3 [label="λ", shape=box, style=rounded, color="black"];
  e2 [label="h", shape=box, style=rounded, color="black"];
  e0 [label="f", shape=box, style=rounded, color="black"];

  // Source connections
  n2 -> e1 [label=""];
  n4 -> e4 [label="0"];
  n2 -> e4 [style=dashed, color="blue", constraint=false, label="b0,0"];
  n5 -> e4 [label="1"];
  n3 -> e3 [label="0"];
  n1 -> e3 [style=dashed, color="blue", constraint=false, label="b0,0"];
  n5 -> e3 [label="1"];
  n0 -> e2 [label=""];
  n1 -> e0 [label=""];

  // Target connections
  e1 -> n4 [label=""];
  e4 -> n7 [label=""];
  e3 -> n6 [label=""];
  e2 -> n5 [label=""];
  e0 -> n3 [label=""];
}
